flowchart LR
  subgraph BP [LinkML blueprints · build time]
    direction TB
    SS["sources/*/schema.yaml"]
    DM["schemas/schema.yaml"]
    GY["gen-yaml · compile · lint"]
    SS --> GY
    DM --> GY
  end

  subgraph ST1 [Stage 1 — Ingest]
    direction TB
    PUB["Publisher raw"]
    AD["Adapter · SchemaNormalizer"]
    PUB --> AD
  end

  subgraph ST2 [Stage 2 — Validate]
    direction TB
    V1["linkml.validator · source schema"]
    BR[("Bronze")]
    V1 -->|pass| BR
  end

  subgraph ST3 [Stage 3 — Transform]
    direction TB
    TR["YamlMapEngine · transform.yaml"]
    SLV[("Silver · per source")]
    TR --> SLV
  end

  subgraph ST4 [Stage 4 — Integrate]
    MR["Merge · dedupe · EntityResolver"]
    MSLV[("Merged Silver")]
    MR --> MSLV
  end

  subgraph ST5 [Stage 5 — Publish]
    direction TB
    V3["linkml.validator · domain schema"]
    GLD[("Gold")]
    V3 -->|pass| GLD
  end

  subgraph QZ [Quarantine]
    Q1[("Validate quarantine")]
    Q3[("Gold quarantine")]
  end

  AD --> V1
  V1 -->|reject| Q1
  SS -.->|schema| V1
  BR --> TR
  SLV --> MR
  MSLV --> V3
  V3 -->|reject| Q3
  DM -.->|schema| V3

  classDef bronze fill:#cd7f32,color:#fff,stroke:#8B4513
  classDef silver fill:#c0c0c0,color:#1a1a1a,stroke:#808080
  classDef gold fill:#ffd700,color:#1a1a1a,stroke:#b8860b
  classDef gate fill:#2b6cb0,color:#fff,stroke:#1a4480
  classDef integrate fill:#6b46c1,color:#fff,stroke:#553c9a
  classDef quarantine fill:#c53030,color:#fff,stroke:#9b2c2c

  class BR bronze
  class SLV,MSLV silver
  class GLD gold
  class V1,V3 gate
  class MR integrate
  class Q1,Q3 quarantine
